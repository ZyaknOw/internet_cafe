APP_ENV=local
APP_DEBUG=false
APP_BASE_URL=http://127.0.0.1:8080
APP_ALLOWED_ORIGINS=http://127.0.0.1:8080
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SUPABASE_TIMEOUT_SECONDS=12

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Do not place real credentials in this template or commit a populated .env file.
# For Hostinger, set APP_ENV=production and SESSION_COOKIE_SECURE=true, and store
# the populated file outside public_html or use the hosting environment settings.
